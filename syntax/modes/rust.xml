  <RULES DEFAULT="COMMENT1" SET="BLOCK_COMMENT">
    <SPAN TYPE="COMMENT1" DELEGATE="BLOCK_COMMENT">
      <BEGIN>/*</BEGIN>
      <END>*/</END>
    </SPAN>
  </RULES>
</MODE>
