<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE MODE SYSTEM "../xmode.dtd">
<MODE>
  <PROPS>
    <PROPERTY NAME="indentOpenBrackets" VALUE="{["/>
    <PROPERTY NAME="indentCloseBrackets" VALUE="}]"/>
    <PROPERTY NAME="noTabs" VALUE="true"/>
    <PROPERTY NAME="tabSize" VALUE="4"/>
    <PROPERTY NAME="lineComment" VALUE="//"/>
  </PROPS>
  <RULES IGNORE_CASE="FALSE" NO_WORD_SEP="_">
    <SPAN TYPE="COMMENT1" DELEGATE="BLOCK_COMMENT">
      <BEGIN>/*</BEGIN>
      <END>*/</END>
    </SPAN>
    <EOL_SPAN TYPE="COMMENT2">//</EOL_SPAN>
    <SPAN_REGEXP TYPE="LITERAL1" HASH_CHARS="bcr">
      <BEGIN>(?:br|cr|r)(#{0,255})"</BEGIN>
      <END>"$1</END>
    </SPAN_REGEXP>
    <SPAN_REGEXP TYPE="LITERAL1" HASH_CHARS="bc&quot;" ESCAPE="\">
      <BEGIN>(?:b|c)?"</BEGIN>
      <END>"</END>
    </SPAN_REGEXP>
    <SEQ_REGEXP TYPE="LITERAL1" HASH_CHARS="b'">b?'(?:\\(?:x[0-9A-Fa-f]{2}|u\{[0-9A-Fa-f_]+\}|.)|[^'\\\r\n])'</SEQ_REGEXP>
    <SEQ_REGEXP TYPE="LABEL" HASH_CHAR="'">'[A-Za-z_]\w*</SEQ_REGEXP>
    <SEQ_REGEXP TYPE="NULL" HASH_CHAR="r">r#[A-Za-z_]\w*</SEQ_REGEXP>
    <SEQ_REGEXP TYPE="KEYWORD2" HASH_CHAR="#">#!?\[</SEQ_REGEXP>
    <SEQ_REGEXP TYPE="FUNCTION" AT_WORD_START="TRUE">[A-Za-z_]\w*!(?=\s*[({\[])</SEQ_REGEXP>
    <SEQ_REGEXP TYPE="DIGIT" HASH_CHARS="0123456789" AT_WORD_START="TRUE">(?:0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*|0[bB][01](?:_?[01])*|0[oO][0-7](?:_?[0-7])*|[0-9](?:_?[0-9])*(?:\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?)(?:_?[iu](?:8|16|32|64|128|size)|_?f(?:32|64))?(?!\w)</SEQ_REGEXP>
    <SEQ TYPE="OPERATOR">!==</SEQ>
    <SEQ TYPE="OPERATOR">&amp;&amp;=</SEQ>
    <SEQ TYPE="OPERATOR">&amp;^=</SEQ>
    <SEQ TYPE="OPERATOR">**=</SEQ>
    <SEQ TYPE="OPERATOR">...</SEQ>
    <SEQ TYPE="OPERATOR">..&lt;</SEQ>
    <SEQ TYPE="OPERATOR">..=</SEQ>
    <SEQ TYPE="OPERATOR">&lt;&lt;=</SEQ>
    <SEQ TYPE="OPERATOR">===</SEQ>
    <SEQ TYPE="OPERATOR">&gt;&gt;=</SEQ>
    <SEQ TYPE="OPERATOR">??=</SEQ>
    <SEQ TYPE="OPERATOR">||=</SEQ>
    <SEQ TYPE="OPERATOR">!!</SEQ>
    <SEQ TYPE="OPERATOR">!=</SEQ>
    <SEQ TYPE="OPERATOR">%=</SEQ>
    <SEQ TYPE="OPERATOR">&amp;&amp;</SEQ>
    <SEQ TYPE="OPERATOR">&amp;^</SEQ>
    <SEQ TYPE="OPERATOR">**</SEQ>
