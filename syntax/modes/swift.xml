  <RULES DEFAULT="COMMENT1" SET="BLOCK_COMMENT">
    <SPAN TYPE="COMMENT1" DELEGATE="BLOCK_COMMENT">
      <BEGIN>/*</BEGIN>
      <END>*/</END>
    </SPAN>
  </RULES>
  <RULES DEFAULT="LITERAL1" SET="STRING">
    <SPAN TYPE="OPERATOR" DELEGATE="INTERPOLATION">
      <BEGIN>\(</BEGIN>
      <END>)</END>
    </SPAN>
    <SEQ_REGEXP TYPE="LITERAL2" HASH_CHAR="\">\\.</SEQ_REGEXP>
  </RULES>
  <RULES IGNORE_CASE="FALSE" SET="INTERPOLATION">
    <SPAN TYPE="OPERATOR" DELEGATE="INTERPOLATION">
      <BEGIN>(</BEGIN>
      <END>)</END>
    </SPAN>
    <IMPORT DELEGATE="MAIN"/>
  </RULES>
