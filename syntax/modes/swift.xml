<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE MODE SYSTEM "../xmode.dtd">
<MODE>
  <PROPS>
    <PROPERTY NAME="indentOpenBrackets" VALUE="{["/>
    <PROPERTY NAME="indentCloseBrackets" VALUE="}]"/>
    <PROPERTY NAME="noTabs" VALUE="true"/>
    <PROPERTY NAME="tabSize" VALUE="4"/>
    <PROPERTY NAME="lineComment" VALUE="//"/>
  </PROPS>
  <RULES IGNORE_CASE="FALSE" NO_WORD_SEP="_">
    <SPAN TYPE="COMMENT1" DELEGATE="BLOCK_COMMENT">
      <BEGIN>/*</BEGIN>
      <END>*/</END>
    </SPAN>
    <EOL_SPAN TYPE="COMMENT2">//</EOL_SPAN>
    <SPAN_REGEXP TYPE="LITERAL1" HASH_CHAR="#">
      <BEGIN>(#+)"""</BEGIN>
      <END>"""$1</END>
    </SPAN_REGEXP>
    <SPAN_REGEXP TYPE="LITERAL1" HASH_CHAR="#">
      <BEGIN>(#+)"</BEGIN>
      <END>"$1</END>
    </SPAN_REGEXP>
    <SPAN TYPE="LITERAL1" DELEGATE="STRING">
      <BEGIN>"""</BEGIN>
      <END>"""</END>
    </SPAN>
    <SPAN TYPE="LITERAL1" NO_LINE_BREAK="TRUE" DELEGATE="STRING">
      <BEGIN>"</BEGIN>
      <END>"</END>
    </SPAN>
    <SPAN TYPE="NULL" NO_LINE_BREAK="TRUE">
      <BEGIN>`</BEGIN>
      <END>`</END>
    </SPAN>
    <SEQ_REGEXP TYPE="KEYWORD2" HASH_CHAR="@">@[A-Za-z_]\w*</SEQ_REGEXP>
    <SEQ_REGEXP TYPE="KEYWORD2" HASH_CHAR="#">#[A-Za-z_]\w*</SEQ_REGEXP>
    <SEQ_REGEXP TYPE="DIGIT" HASH_CHARS="0123456789" AT_WORD_START="TRUE">(?:0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*|0[bB][01](?:_?[01])*|0[oO][0-7](?:_?[0-7])*|[0-9](?:_?[0-9])*(?:\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?)</SEQ_REGEXP>
    <SEQ TYPE="OPERATOR">!==</SEQ>
