<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE MODE SYSTEM "../xmode.dtd">
<MODE>
  <PROPS>
    <PROPERTY NAME="indentOpenBrackets" VALUE="{["/>
    <PROPERTY NAME="indentCloseBrackets" VALUE="}]"/>
    <PROPERTY NAME="noTabs" VALUE="true"/>
    <PROPERTY NAME="tabSize" VALUE="4"/>
    <PROPERTY NAME="lineComment" VALUE="#"/>
  </PROPS>
  <RULES IGNORE_CASE="FALSE">
    <EOL_SPAN TYPE="COMMENT1" AT_WHITESPACE_END="TRUE">#</EOL_SPAN>
    <SEQ_REGEXP TYPE="KEYWORD1" AT_WHITESPACE_END="TRUE">(?i:FROM|RUN|CMD|LABEL|MAINTAINER|EXPOSE|ENV|ADD|COPY|ENTRYPOINT|VOLUME|USER|WORKDIR|ARG|ONBUILD|STOPSIGNAL|HEALTHCHECK|SHELL)\b</SEQ_REGEXP>
    <SPAN_REGEXP TYPE="LITERAL2" HASH_CHAR="&lt;">
      <BEGIN>&lt;&lt;-?[\x27"]?([A-Za-z_][A-Za-z0-9_]*)[\x27"]?</BEGIN>
      <END REGEXP="TRUE" AT_LINE_START="TRUE">^\t*$1\s*$</END>
    </SPAN_REGEXP>
    <SPAN TYPE="LITERAL1" ESCAPE="\" NO_LINE_BREAK="TRUE">
      <BEGIN>"</BEGIN>
      <END>"</END>
    </SPAN>
    <SPAN TYPE="LITERAL1" ESCAPE="\" NO_LINE_BREAK="TRUE">
      <BEGIN>'</BEGIN>
      <END>'</END>
    </SPAN>
    <SEQ_REGEXP TYPE="KEYWORD2" HASH_CHAR="$">\$\{[^}\r\n]+\}|\$[A-Za-z_]\w*</SEQ_REGEXP>
    <SEQ_REGEXP TYPE="KEYWORD2" HASH_CHAR="-">--[a-z][a-z-]*(?:=[^\s]+)?</SEQ_REGEXP>
    <SEQ TYPE="OPERATOR">\</SEQ>
    <SEQ_REGEXP TYPE="KEYWORD2" AT_WORD_START="TRUE">(?i:AS)\b</SEQ_REGEXP>
  </RULES>
</MODE>
