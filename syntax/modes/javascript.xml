    </KEYWORDS>
  </RULES>
  <RULES DEFAULT="LITERAL3" ESCAPE="\" SET="TEMPLATE_LITERAL">
    <SPAN TYPE="OPERATOR" DELEGATE="EXPRESSION">
      <BEGIN>${</BEGIN>
      <END>}</END>
    </SPAN>
  </RULES>
  <RULES IGNORE_CASE="FALSE" NO_WORD_SEP="_$" SET="EXPRESSION">
    <SPAN TYPE="OPERATOR" DELEGATE="EXPRESSION">
      <BEGIN>{</BEGIN>
      <END>}</END>
    </SPAN>
    <IMPORT DELEGATE="MAIN"/>
  </RULES>
  <RULES DEFAULT="MARKUP" ESCAPE="\" SET="REGEX_BODY">
    <SPAN TYPE="MARKUP" ESCAPE="\">
      <BEGIN>[</BEGIN>
      <END>]</END>
    </SPAN>
  </RULES>
</MODE>
