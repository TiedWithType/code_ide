      <BEGIN>/*</BEGIN>
      <END>*/</END>
    </SPAN>
  </RULES>
  <RULES DEFAULT="LITERAL1" ESCAPE="\" SET="TEMPLATE">
    <SPAN TYPE="OPERATOR" DELEGATE="EXPRESSION">
      <BEGIN>${</BEGIN>
      <END>}</END>
    </SPAN>
    <SEQ_REGEXP TYPE="KEYWORD2" HASH_CHAR="$">\$[A-Za-z_]\w*</SEQ_REGEXP>
  </RULES>
  <RULES DEFAULT="LITERAL1" SET="TEMPLATE_RAW">
    <SPAN TYPE="OPERATOR" DELEGATE="EXPRESSION">
      <BEGIN>${</BEGIN>
      <END>}</END>
    </SPAN>
    <SEQ_REGEXP TYPE="KEYWORD2" HASH_CHAR="$">\$[A-Za-z_]\w*</SEQ_REGEXP>
  </RULES>
  <RULES IGNORE_CASE="FALSE" SET="EXPRESSION">
    <SPAN TYPE="OPERATOR" DELEGATE="EXPRESSION">
