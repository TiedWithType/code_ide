<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list><item android:height="2dp" android:gravity="bottom">
            <shape android:shape="rectangle"><solid android:color="?android:attr/colorAccent"/></shape>
        </item></layer-list>
    </item>
    <item>
        <layer-list><item android:height="1dp" android:gravity="bottom">
            <shape android:shape="rectangle"><solid android:color="?android:attr/textColorSecondary"/></shape>
        </item></layer-list>
    </item>
</selector>
